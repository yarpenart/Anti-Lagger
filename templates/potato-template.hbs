<div class="potato potato-container">

	<h1 id="potato-title">{{ localize "AntiLagger.Selection"}}</h1>

	<div class='potato-master-container'>
		<div class='potato-level-container' level='0' {{#if (eq potato_quality 0)}} active="true" {{/if}} >
			<div class="potato-level-row">
				<img src='modules/anti-lagger/styles/img/bad_potato.jpg'>
			</div>
			<div class="potato-level-row-text">
				<h2>{{ localize "AntiLagger.BadTitle" }}</h2>
				<p>{{ localize "AntiLagger.BadDescription" }}</p>
			</div>
		</div>
		<div class='potato-level-container' level='1' {{#if (eq potato_quality 1)}} active="true" {{/if}} >
			<div class="potato-level-row">
				<img src='modules/anti-lagger/styles/img/potato.png'>
			</div>
			<div class="potato-level-row-text">
				<h2>{{ localize "AntiLagger.MediumTitle" }}</h2>
				<p>{{ localize "AntiLagger.MediumDescription" }}</p>
			</div>
		</div>
		<div class='potato-level-container' level='2' {{#if (eq potato_quality 2)}} active="true" {{/if}} >
			<div class="potato-level-row">
				<img src='modules/anti-lagger/styles/img/good_potato.jpg'>
			</div>
			<div class="potato-level-row-text">
				<h2>{{ localize "AntiLagger.GoodTitle" }}</h2>
				<p>{{ localize "AntiLagger.GoodDescription" }}</p>
			</div>
		</div>
	</div>

	<hr>

	<button type="submit" class="dialog-button" data-button="confirm">
		<i class="fa-solid fa-gauge"></i>
		{{ localize "AntiLagger.Accept" }}
	</button>

</div>
